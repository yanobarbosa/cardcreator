# Umami website id (https://cloud.umami.is). Only read on production builds
# (MODE=production) — analytics is a no-op in dev and staging/fork builds
# regardless of whether this is set.
VITE_UMAMI_WEBSITE_ID=

# Firebase client configuration (public values embedded in the frontend build)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
